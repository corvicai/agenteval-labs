{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Go API (Local)",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "${workspaceFolder}/server_go/main.go",
            "cwd": "${workspaceFolder}/server_go",
            "env": {
                "DATABASE_URL": "host=localhost user=postgres password=postgres dbname=benchmarking port=5432 sslmode=disable",
                "JWT_SECRET": "dev-secret-debug-mode",
                "APP_ENV": "development",
                "PORT": "8080"
            },
            "dlvFlags": [
                "--check-go-version=false"
            ]
        }
    ]
}
