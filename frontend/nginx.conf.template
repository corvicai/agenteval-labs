server {
    listen ${PORT};
    server_name localhost docker _;

    # Use standard resolvers (Google DNS) to ensure external URLs resolve in Cloud Run
    resolver 8.8.8.8 8.8.4.4 valid=30s;

    # Gzip compression
    gzip on;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml application/xml+rss text/javascript;

    # Root directory for static files
    root /usr/share/nginx/html;
    index index.html;

    # API proxy
    location /api/ {
        # Using a variable in proxy_pass forces nginx to resolve the URL at runtime.
        set $api_url "${API_URL}";
        
        # Capture the host for the Host header (Cloud Run requirement)
        set $api_host "";
        if ($api_url ~* "^https?://([^/]+)") {
            set $api_host $1;
        }

        # Robust URI stripping: capture everything after /api/
        # and pass it to the backend.
        if ($request_uri ~* "^/api/(.*)") {
            set $api_path $1;
        }

        proxy_pass $api_url/$api_path;
        proxy_http_version 1.1;
        
        # CRITICAL for Cloud Run: Host header must match the target service URL
        proxy_set_header Host $api_host;
        
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # WebSocket proxy
    location /ws {
        set $api_url "${API_URL}";

        set $api_host "";
        if ($api_url ~* "^https?://([^/]+)") {
            set $api_host $1;
        }

        # Keep request URI to preserve /ws and query params.
        proxy_pass $api_url$request_uri;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Sec-WebSocket-Protocol $http_sec_websocket_protocol;
        proxy_set_header Host $api_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 86400;
    }

    # SPA support: redirect all other requests to index.html
    location / {
        try_files $uri $uri/ /index.html;
    }
}
