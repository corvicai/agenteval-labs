resolver 127.0.0.11 valid=10s;  # Docker internal DNS

server {
    listen ${PORT};
    server_name localhost docker _;

    # Gzip compression
    gzip on;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml application/xml+rss text/javascript;

    # Root directory for static files
    root /usr/share/nginx/html;
    index index.html;

    # API proxy
    location /api/ {
        # Cloud Run services usually have a stable URL, but for local 
        # we still want to support the docker name.
        # We can use an environment variable for this too.
        proxy_pass ${API_URL};
        rewrite ^/api/(.*) /$1 break;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # WebSocket proxy
    location /ws {
        proxy_pass ${API_URL};
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_read_timeout 86400;
    }

    # SPA support: redirect all other requests to index.html
    location / {
        try_files $uri $uri/ /index.html;
    }
}
