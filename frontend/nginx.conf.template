server {
    listen ${PORT};
    server_name localhost docker _;

    # Use standard resolvers (Google DNS) to ensure external URLs resolve in Cloud Run
    resolver 8.8.8.8 8.8.4.4 valid=30s;

    # Gzip compression
    gzip on;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml application/xml+rss text/javascript;

    # Root directory for static files
    root /usr/share/nginx/html;
    index index.html;

    # API proxy
    location /api/ {
        # Using a variable in proxy_pass forces nginx to resolve the URL at runtime
        # instead of at startup, preventing a crash if the host is down.
        set $api_upstream "${API_URL}";
        proxy_pass $api_upstream;
        rewrite ^/api/(.*) /$1 break;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # WebSocket proxy
    location /ws {
        set $api_upstream "${API_URL}";
        proxy_pass $api_upstream;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_read_timeout 86400;
    }

    # SPA support: redirect all other requests to index.html
    location / {
        try_files $uri $uri/ /index.html;
    }
}
