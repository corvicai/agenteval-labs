# ========== DATABASE CONFIG ==========
# Local Docker Compose
DATABASE_URL=host=db user=postgres password=postgres dbname=benchmarking port=5432 sslmode=disable
# Cloud Run (Cloud SQL) - Connection via unix socket or IP
# DATABASE_URL=host=/cloudsql/PROJECT:REGION:INSTANCE user=postgres password=xxx dbname=benchmarking sslmode=disable

# ========== SERVICE URLs ==========
# How the Frontend Nginx proxy finds the Go API (used in Docker)
# For Cloud Run, this will be the URL of your Go service
API_URL=http://go-api:8080

# ========== SECURITY ==========
# Change this in production!
JWT_SECRET=use-a-long-random-string-at-least-32-chars
# 32 characters for AES-256
ENCRYPTION_KEY=12345678901234567890123456789012

# ========== SERVER ==========
PORT=8080
APP_ENV=development
# Trust X-Real-IP / X-Forwarded-For headers for client IP extraction.
# Automatically enabled when APP_ENV=production. Set to "true" in other
# environments only when behind a trusted reverse proxy (Cloud Run, IAP,
# nginx). Leaving unset in dev avoids IP spoofing via crafted headers.
# TRUST_PROXY_HEADERS=false

# ========== ORCHESTRATION ENGINE ==========
# Number of task workers (default: 50)
# ENGINE_WORKERS=50
# Buffered capacity of the task queue (default: 10000). Increase for very
# large benchmark runs; decrease to apply back-pressure sooner.
# ENGINE_QUEUE_SIZE=10000

# ========== FRONTEND DEV ==========
# Optional: Configure HMR (Hot Module Replacement)
# Useful when running behind a reverse proxy or custom domain
# VITE_HMR_HOST=localhost
# VITE_HMR_CLIENT_PORT=443
# VITE_HMR_PROTOCOL=wss

# Match remote default: 180 seconds
VITE_AFK_TIMEOUT_MS=180000
